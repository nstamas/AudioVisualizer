{
  "audio": {
    "input_device": "default",
    "sample_rate": 44100,
    "buffer_size": 512,
    "fft_size": 2048
  },
  "visualization": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "preset_path": "assets/presets/",
    "preset_duration": 30.0,
