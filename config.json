    "outline": false,
    "shadow": false,
    "smearing": false,
    "blur": false,
    "bloom": false
  },
  "window": {
    "title": "Audio Visualizer",
    "fullscreen": false,
    "vsync": true,
    "msaa_samples": 4
  }
}
